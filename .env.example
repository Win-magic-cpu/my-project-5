# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# ===== 大模型（阿里云百炼 OpenAI 兼容接口）=====
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 模拟电商业务后端 =====
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# ===== 对话状态存储 =====
# MySQL（推荐）
DATABASE_URL=mysql+aiomysql://root:123456@127.0.0.1:3306/customer_service?charset=utf8mb4
# 本地零依赖体验可选 SQLite（去掉下一行注释，并注释掉上面的 MySQL 配置）
# DATABASE_URL=sqlite+aiosqlite:///./data/customer_service.db

# ===== 服务端口 =====
APP_HOST=0.0.0.0
APP_PORT=18082

# ===== 会话与建表 =====
SESSION_TIMEOUT_SECONDS=3600
# 本地开发可保持 true（启动时自动建表）；生产建议 false，改用 alembic upgrade head
AUTO_CREATE_TABLES=true

# ===== 检索增强（RAG）=====
# auto：配了 LLM_API_KEY 用 dashscope，否则用本地 hashing（离线可跑）
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=512
RAG_TOP_K=3
RAG_MIN_SCORE=0.15
RAG_INDEX_PATH=./data/rag_index.json
